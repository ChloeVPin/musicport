{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "musicport",
  "version": "0.1.0",
  "identifier": "com.musicport.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "musicport",
        "width": 1152,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "libimobiledevice6 | libimobiledevice-1.0-6",
          "libplist3 | libplist4 | libplist-2.0-3 | libplist-2.0-4",
          "libusbmuxd6 | libusbmuxd-2.0-6",
          "libssl3 | libssl1.1"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}